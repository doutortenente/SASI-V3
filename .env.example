# Endereço e chave PUBLICÁVEL do Supabase. Públicos por desenho (vão para o
# navegador). Reserva no código em src/lib/supabase/config.ts.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>

# Credencial da sessão automática. SÓ SERVIDOR — sem NEXT_PUBLIC_, nunca vai
# para o bundle. É o que substitui a tela de login (uso solo, decisão de
# produto). Ver src/lib/supabase/sessao.ts.
# Sem estas duas o app abre sem sessão e a RLS não devolve nenhuma linha.
SASI_SESSAO_EMAIL=
SASI_SESSAO_SENHA=
