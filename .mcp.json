{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=fpemjplgtyhztowwemfz"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${SUPABASE_SECRET_KEY}"
      }
    }
  }
}
